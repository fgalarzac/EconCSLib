  "governing_corrections": [
    {
      "id": "GJ18-CORR-SELLER-CARRIER-2026-07-24",
      "clause": "The finite ordered seller carrier has M >= 2 types and an explicit uniform prior.",
      "source_anchor": "adjectivesmodel.tex:22-24,85-90,111-125",
      "relation": "Makes the denominator and adjacent-pair domain explicit.",
      "model_evidence": "ClarifiedSourceModel.at_least_two_seller_types; ClarifiedSourceModel.type_prior_uniform",
      "does_not_claim_archive_derivation": true
    },
    {
      "id": "GJ18-CORR-MATCH-RATES-2026-07-24",
      "clause": "For every seller type theta, 0 < g(theta) <= 1 and n_k(theta)=floor(k g(theta)).",
      "source_anchor": "adjectivesmodel.tex:26-29",
      "relation": "Makes the diverging-sample and at-most-one-match conditions explicit.",
      "model_evidence": "ClarifiedSourceModel.match_rate_bounds",
      "does_not_claim_archive_derivation": true
    },
    {
      "id": "GJ18-CORR-AGGREGATE-INDEX-2026-07-24",
      "clause": "The aggregate averages exactly n_k(theta) rating observations.",
      "source_anchor": "adjectivesmodel.tex:54-59",
      "relation": "Corrects the displayed off-by-one sum endpoint.",
      "model_evidence": "PaperInterface.source_definition_aggregate_score_formula",
      "does_not_claim_archive_derivation": true
    },
    {
      "id": "GJ18-CORR-RATING-CARRIER-2026-07-24",
      "clause": "There are at least two rating levels; cross-type strict upper tails apply only above the bottom cutoff; no terminal full-support condition is imposed.",
      "source_anchor": "adjectivesmodel.tex:32-51",
      "relation": "Repairs vacuous and impossible endpoint cases without weakening the ranking conclusion.",
      "model_evidence": "ClarifiedSourceModel.nontrivial_rating_scale; FiniteOrdinalSourceModel.quality_tails_strictly_increase_above_bottom",
      "does_not_claim_archive_derivation": true
    },
    {
      "id": "GJ18-CORR-IID-STATE-LAW-2026-07-24",
      "clause": "Ratings are conditionally iid by seller type and independent across seller histories; the horizon state is the induced finite product law.",
      "source_anchor": "adjectivesmodel.tex:40,67-73",
      "relation": "Replaces the archive recurrence as the governing state-evolution clause.",
      "model_evidence": "ClarifiedSourceModel.conditional_iid_ratings_and_independent_seller_histories",
      "does_not_claim_archive_derivation": true
    },
    {
      "id": "GJ18-CORR-ADJACENT-INDEX-2026-07-24",
      "clause": "The adjacent-pair minimum ranges over 0 <= i <= M-2.",
      "source_anchor": "adjectivesmodel.tex:111-125; appendix_theory.tex:77-95",
      "relation": "Corrects an endpoint that can name theta_M.",
      "model_evidence": "finiteChainAdjacentIndex; ClarifiedSourceModel.correctedTheorem1Rate",
      "does_not_claim_archive_derivation": true
    },
    {
      "id": "GJ18-CORR-EXTENDED-RATE-2026-07-24",
      "clause": "The Legendre and threshold infimum use extended-real arithmetic; the final rate is separately proved finite.",
      "source_anchor": "adjectivesmodel.tex:111-125; appendix_theory.tex:7-8,44-53",
      "relation": "Corrects the rate codomain for infeasible thresholds.",
      "model_evidence": "PaperInterface.source_definition_extended_rate_function_formula; PaperInterface.author_approved_corrected_model_theorem1_finite_real_rate",
      "does_not_claim_archive_derivation": true
    },
    {
      "id": "GJ18-CORR-APPENDIX-DISCRETE-PROOF-2026-07-24",
      "clause": "The weak-inversion and 1-P_k rates are proved directly for finite iid product laws with the required fixed-constant comparison.",
      "source_anchor": "appendix_theory.tex:7-69",
      "relation": "Replaces the unsupported continuum-integral transfer.",
      "model_evidence": "PaperInterface.source_appendix_problessthan_score_gap_rate_iid_completion; PaperInterface.source_appendix_pk_ld_complement_rate_iid_completion",
      "does_not_claim_archive_derivation": true
    }
  ],
