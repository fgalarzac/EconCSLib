/--
Proposition 3.4 source convention: Algorithm 7 starts from the full candidate
set as the active set. This supplies both the active-subset premise and the
first-choice-in-initial-active premise used by the generated replay route.
-/
theorem paper_proposition3_4_initial_active_source_convention_facts
    {Voter Candidate : Type*} [DecidableEq Candidate]
    {voters : Finset Voter} {ballots : Voter → RCVBallot Candidate}
    {candidates : Finset Candidate}
    {feasibleSequence : paper_rcv_sequence → Prop}
    {initialActive : paper_rcv_sequence → Finset Candidate}
    (hinitial :
      ∀ sequence, feasibleSequence sequence →
        initialActive sequence = candidates)
    (hfirst_choice_candidates :
      ∀ voter, voter ∈ voters →
        Ballot.firstChoiceIn (ballots voter) candidates) :
    (∀ sequence, feasibleSequence sequence →
        initialActive sequence ⊆ candidates) ∧
      (∀ sequence, feasibleSequence sequence →
        ∀ voter, voter ∈ voters →
          Ballot.firstChoiceIn (ballots voter) (initialActive sequence)) := by
  constructor
  · intro sequence hfeasible
    rw [hinitial sequence hfeasible]
  · intro sequence hfeasible voter hvoter
    simpa [hinitial sequence hfeasible] using
      hfirst_choice_candidates voter hvoter

