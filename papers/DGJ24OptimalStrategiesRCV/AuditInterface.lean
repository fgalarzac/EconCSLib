/--
Algorithm 7 sorted Predict-Losses source replay: the canonical profile replay
that eliminates the sorted Predict-Losses order first gives the counted
initial-loss prefix used by the transfer loop.

Source status: source-run extraction bridge for Proposition 3.4.
-/
theorem paper_predict_losses_sorted_transfer_initial_loss_prefix_of_canonical_profile_group_elimination_replay
    {Voter Candidate : Type*} [DecidableEq Candidate]
    {voters : Finset Voter} {ballots : Voter → RCVBallot Candidate}
    {candidates : Finset Candidate}
    {sequence : paper_rcv_sequence}
    {budget firstChoiceThreshold topFirstChoice quota : ℕ}
    (hsequence :
      sequence =
        paper_rcv_sequence_from_trace
          (paper_canonical_profile_group_elimination_generated_trace
            voters ballots
            ((paper_predict_losses_sorted_transfer_final_order voters ballots
              candidates budget firstChoiceThreshold).order).toFinset
            ((candidates ∩
              ((paper_predict_losses_sorted_transfer_final_order voters ballots
                candidates budget firstChoiceThreshold).order).toFinset).card)
            candidates)) :
    rcvSequenceHasInitialLossPrefix sequence
      (paper_predict_losses_transfer_initial_loss_bound topFirstChoice quota
        ((paper_predict_losses_sorted_transfer_final_order voters ballots
          candidates budget firstChoiceThreshold).order.map
          (paper_predict_losses_strict_support_transfer_cap voters ballots
            candidates))) := by
  let lossOrder :=
    (paper_predict_losses_sorted_transfer_final_order voters ballots candidates
      budget firstChoiceThreshold).order
  let lowerBound :=
    paper_predict_losses_transfer_initial_loss_bound topFirstChoice quota
      (lossOrder.map
        (paper_predict_losses_strict_support_transfer_cap voters ballots
          candidates))
  have hsubset :
      lossOrder.toFinset ⊆ candidates ∩ lossOrder.toFinset := by
    intro candidate hcandidate
    have hmem_order : candidate ∈ lossOrder := by
      simpa using hcandidate
    have hpredict :
        candidate ∈
          paper_predict_losses_candidates voters ballots candidates budget
            firstChoiceThreshold := by
      simpa [lossOrder] using
        (mem_paper_predict_losses_sorted_transfer_final_order_iff
          (voters := voters)
          (ballots := ballots)
          (candidates := candidates)
          (budget := budget)
          (firstChoiceThreshold := firstChoiceThreshold)
          (candidate := candidate)).mp hmem_order
    have hcandidates : candidate ∈ candidates :=
      (mem_predictLossesCandidates_iff.mp
        (by
          simpa [paper_predict_losses_candidates, predictLossesCandidates]
            using hpredict)).1
    exact Finset.mem_inter.mpr ⟨hcandidates, hcandidate⟩
  have hlength : lowerBound ≤ (candidates ∩ lossOrder.toFinset).card := by
    have hlower_order : lowerBound ≤ lossOrder.length := by
      simpa [lossOrder, lowerBound] using
        paper_predict_losses_sorted_transfer_initial_loss_bound_le_order_length
          voters ballots candidates budget firstChoiceThreshold topFirstChoice
          quota
    have hnodup : lossOrder.Nodup := by
      simpa [lossOrder] using
        (paper_predict_losses_sorted_transfer_final_order voters ballots
          candidates budget firstChoiceThreshold).nodup_order
    calc
      lowerBound ≤ lossOrder.length := hlower_order
      _ = lossOrder.toFinset.card :=
          (List.toFinset_card_of_nodup hnodup).symm
      _ ≤ (candidates ∩ lossOrder.toFinset).card :=
          Finset.card_le_card hsubset
  have htrace_prefix :
      (paper_canonical_profile_group_elimination_generated_trace voters ballots
        lossOrder.toFinset ((candidates ∩ lossOrder.toFinset).card)
        candidates).HasInitialEliminationPrefix lowerBound := by
    exact
      paper_canonical_profile_group_elimination_generated_trace_initial_elimination_prefix_of_le
        voters ballots lossOrder.toFinset hlength rfl
  simpa [lossOrder, lowerBound] using
    paper_rcv_sequence_initial_loss_prefix_of_trace_initial_elimination_prefix
      hsequence htrace_prefix

/--
Algorithm 7 canonical Predict-Losses source replay: the canonical profile
replay that eliminates the computed Predict-Losses order first gives the
counted initial-loss prefix used by the transfer loop.

Source status: source-run extraction bridge for Proposition 3.4.
-/
theorem paper_proposition3_4_canonical_predict_losses_profile_initial_loss_prefix_of_canonical_profile_group_elimination_replay
    {Voter Candidate : Type*} [DecidableEq Candidate]
    {voters : Finset Voter} {ballots : Voter → RCVBallot Candidate}
    {candidates : Finset Candidate}
    {sequence : paper_rcv_sequence}
    {budget firstChoiceThreshold topFirstChoice quota : ℕ}
    (hsequence :
      sequence =
        paper_rcv_sequence_from_trace
          (paper_canonical_profile_group_elimination_generated_trace
            voters ballots
            ((paper_predict_losses_final_order voters ballots candidates budget
              firstChoiceThreshold).order).toFinset
            ((candidates ∩
              ((paper_predict_losses_final_order voters ballots candidates
                budget firstChoiceThreshold).order).toFinset).card)
            candidates)) :
    rcvSequenceHasInitialLossPrefix sequence
      (paper_predict_losses_transfer_initial_loss_bound topFirstChoice quota
        (((paper_predict_losses_candidates voters ballots candidates budget
          firstChoiceThreshold).toList).map
          (predictLossesProfileTransferValue voters ballots candidates budget
            firstChoiceThreshold))) := by
  let lossOrder :=
    (paper_predict_losses_final_order voters ballots candidates budget
      firstChoiceThreshold).order
  let transfers :=
    (((paper_predict_losses_candidates voters ballots candidates budget
      firstChoiceThreshold).toList).map
      (predictLossesProfileTransferValue voters ballots candidates budget
        firstChoiceThreshold))
  let lowerBound :=
    paper_predict_losses_transfer_initial_loss_bound topFirstChoice quota
      transfers
  have hsubset :
      lossOrder.toFinset ⊆ candidates ∩ lossOrder.toFinset := by
    intro candidate hcandidate
    have hmem_order : candidate ∈ lossOrder := by
      simpa using hcandidate
    have hpredict :
        candidate ∈
          paper_predict_losses_candidates voters ballots candidates budget
            firstChoiceThreshold := by
      simpa [lossOrder, paper_predict_losses_final_order] using hmem_order
    have hcandidates : candidate ∈ candidates :=
      (mem_predictLossesCandidates_iff.mp
        (by
          simpa [paper_predict_losses_candidates, predictLossesCandidates]
            using hpredict)).1
    exact Finset.mem_inter.mpr ⟨hcandidates, hcandidate⟩
  have hlength : lowerBound ≤ (candidates ∩ lossOrder.toFinset).card := by
    have hlower_order : lowerBound ≤ lossOrder.length := by
      have hlower_transfer : lowerBound ≤ transfers.length :=
        paper_predict_losses_transfer_initial_loss_bound_le_length
          topFirstChoice quota transfers
      have htransfer_len : transfers.length = lossOrder.length := by
        simp [transfers, lossOrder, paper_predict_losses_final_order]
      exact by
        simpa [lowerBound, htransfer_len] using hlower_transfer
    have hnodup : lossOrder.Nodup := by
      simpa [lossOrder] using
        (paper_predict_losses_final_order voters ballots candidates budget
          firstChoiceThreshold).nodup_order
    calc
      lowerBound ≤ lossOrder.length := hlower_order
      _ = lossOrder.toFinset.card :=
          (List.toFinset_card_of_nodup hnodup).symm
      _ ≤ (candidates ∩ lossOrder.toFinset).card :=
          Finset.card_le_card hsubset
  have htrace_prefix :
      (paper_canonical_profile_group_elimination_generated_trace voters ballots
        lossOrder.toFinset ((candidates ∩ lossOrder.toFinset).card)
        candidates).HasInitialEliminationPrefix lowerBound := by
    exact
      paper_canonical_profile_group_elimination_generated_trace_initial_elimination_prefix_of_le
        voters ballots lossOrder.toFinset hlength rfl
  simpa [lossOrder, transfers, lowerBound] using
    paper_rcv_sequence_initial_loss_prefix_of_trace_initial_elimination_prefix
      hsequence htrace_prefix

/--
An initial run of eliminations focused on the listed candidates supplies the
