def paper_top_first_choice_count
    {Voter Candidate : Type*} [DecidableEq Candidate]
    (voters : Finset Voter) (ballots : Voter → RCVBallot Candidate)
    (candidates : Finset Candidate) : ℕ :=
  candidates.sup (fun candidate =>
    Ballot.firstChoiceCount voters ballots candidate)

theorem paper_firstChoiceCount_le_top_first_choice_count
    {Voter Candidate : Type*} [DecidableEq Candidate]
    (voters : Finset Voter) (ballots : Voter → RCVBallot Candidate)
    {candidates : Finset Candidate} {candidate : Candidate}
    (hcandidate : candidate ∈ candidates) :
    Ballot.firstChoiceCount voters ballots candidate ≤
      paper_top_first_choice_count voters ballots candidates := by
  simpa [paper_top_first_choice_count] using
    Finset.le_sup (s := candidates)
      (f := fun candidate =>
        Ballot.firstChoiceCount voters ballots candidate)
      hcandidate

