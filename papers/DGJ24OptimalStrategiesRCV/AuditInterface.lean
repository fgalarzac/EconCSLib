/--
Sorted Predict-Losses initial-loss certificate constructor: once the source
sequence has an initial losing prefix as long as the sorted transfer-loop
bound, the sorted decreasing-transfer Predict-Losses order supplies the loop
prefix and lower-bound facts internally.

Source status: Algorithm 7 sorted-order initial-loss certificate bridge.
-/
noncomputable def paper_predict_losses_initial_loss_prefix_certificate_of_sorted_transfer_order_and_initial_loss_prefix
    {Voter Candidate : Type*} [DecidableEq Candidate]
    {voters : Finset Voter} {ballots : Voter → RCVBallot Candidate}
    {candidates : Finset Candidate} {budget firstChoiceThreshold
      topFirstChoice quota : ℕ}
    {sequence : RCVSequence}
    (hprefix :
      rcvSequenceHasInitialLossPrefix sequence
        (paper_predict_losses_transfer_initial_loss_bound topFirstChoice quota
          ((paper_predict_losses_sorted_transfer_final_order voters ballots
            candidates budget firstChoiceThreshold).order.map
            (paper_predict_losses_strict_support_transfer_cap voters ballots
              candidates)))) :
    paper_predict_losses_initial_loss_prefix_certificate voters ballots
      candidates budget firstChoiceThreshold rcvSequenceInitialLossCount
      (paper_predict_losses_transfer_initial_loss_bound topFirstChoice quota
        ((paper_predict_losses_sorted_transfer_final_order voters ballots
          candidates budget firstChoiceThreshold).order.map
          (paper_predict_losses_strict_support_transfer_cap voters ballots
            candidates)))
      sequence :=
by
  let lossOrder :=
    (paper_predict_losses_sorted_transfer_final_order voters ballots candidates
      budget firstChoiceThreshold).order
  let lowerBound :=
    paper_predict_losses_transfer_initial_loss_bound topFirstChoice quota
      (lossOrder.map
        (paper_predict_losses_strict_support_transfer_cap voters ballots
          candidates))
  have hloop :
      paper_predict_losses_loop_prefix voters ballots candidates budget
        firstChoiceThreshold lossOrder := by
    simpa [lossOrder] using
      paper_predict_losses_sorted_transfer_order_loop_prefix voters ballots
        candidates budget firstChoiceThreshold
  have hlower : lowerBound ≤ lossOrder.length := by
    simpa [lossOrder, lowerBound] using
      paper_predict_losses_sorted_transfer_initial_loss_bound_le_order_length
        voters ballots candidates budget firstChoiceThreshold topFirstChoice
        quota
  have hinitial_lower :
      lowerBound ≤ rcvSequenceInitialLossCount sequence := by
    simpa [lossOrder, lowerBound] using
      RoundOutcome.length_le_initialLossCount_of_hasInitialLossPrefix hprefix
  exact
    {
      lossPrefix := lossOrder.take lowerBound
      prefix_nodup := by
        exact hloop.1.sublist (List.take_sublist _ _)
      prefix_subset_lossCandidates := by
        intro candidate hcandidate
        exact hloop.2 candidate (List.mem_of_mem_take hcandidate)
      lower_le_prefix_length := by
        change lowerBound ≤ (lossOrder.take lowerBound).length
        simp [List.length_take, Nat.min_eq_left hlower]
      prefix_length_le_initialLossCount := by
        simpa [List.length_take, Nat.min_eq_left hlower] using
          hinitial_lower
    }

