            (fun round =>
              (Ballot.activeSupport
                (beforeVoters state) (before state) (active state round) candidate).card)
            (fun round =>
              (Ballot.activeSupport
                (afterVoters state) (after state) (active state round) candidate).card)
            (beforeExit state)) ∧
