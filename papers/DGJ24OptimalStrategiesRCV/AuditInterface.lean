theorem paper_predict_wins_loop_from_source_order_spec
    {Voter Candidate : Type*} [DecidableEq Candidate]
    (voters : Finset Voter) (ballots : Voter → RCVBallot Candidate)
    (candidates : Finset Candidate) (assignedBudget : Candidate → ℕ)
    (quota : ℕ) (sourceOrder : List Candidate) :
    paper_predict_wins_budget_ready_selection_loop voters ballots candidates
      assignedBudget quota [] sourceOrder
      (paper_predict_wins_loop_from_source_order voters ballots candidates
        assignedBudget quota sourceOrder) := by
  exact predictWinsLoopFromSourceOrder_spec voters ballots candidates
    assignedBudget quota sourceOrder

/--
Algorithm 7 Predict-Wins source-order identity: if the source order is already
the ordered list of candidates ready at their processed-prefix states, the
executable Predict-Wins loop leaves it unchanged.
