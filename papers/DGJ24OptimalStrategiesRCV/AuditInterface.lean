leave the contest.

Source status: concrete Algorithm 3 ballot constructor from the displayed
candidate-allocation map.
-/
noncomputable def paper_algorithm3_generated_structure_exact_fill_from_candidate_allocations
    {Voter Candidate : Type*} [DecidableEq Voter]
    (struct : paper_rcv_structure Candidate)
    (allocatedVoters : Candidate → Finset Voter)
    (voter : Voter) : RCVBallot Candidate :=
  struct.finalOrder.order.filter fun candidate =>
    voter ∈ allocatedVoters candidate

/--
The candidate-allocation exact-fill constructor realizes the generated
round-local voter support: at a generated round, the exact-fill ballot first
supports that round's candidate exactly for voters assigned to that candidate.

Source status: Lean-checked no-new-slack constructor for Algorithm 3's
generated-order ballot construction.
-/
theorem paper_algorithm3_generated_structure_exact_fill_from_candidate_allocations_nextActive_iff
    {Voter Candidate : Type*} [DecidableEq Voter] [DecidableEq Candidate]
    (struct : paper_rcv_structure Candidate)
    (initialActive : Finset Candidate)
    (tallyOf : Finset Candidate → Candidate → ℕ)
    (allocatedVoters : Candidate → Finset Voter)
    (horder_subset : struct.finalOrder.order.toFinset ⊆ initialActive)
    (step :
      Fin (paper_generated_trace_of_structure struct initialActive tallyOf).steps.length)
    (voter : Voter) :
    Ballot.nextActive
        (paper_algorithm3_generated_structure_exact_fill_from_candidate_allocations
          struct allocatedVoters voter)
        (((paper_generated_trace_of_structure struct initialActive tallyOf).steps.get
          step).beforeActive) =
        some (paper_generated_structure_step_candidate struct initialActive tallyOf
          step) ↔
      voter ∈
        allocatedVoters
          (paper_generated_structure_step_candidate struct initialActive tallyOf
            step) := by
  let order := struct.finalOrder.order
  let idx := step.1
  have hlen := paper_generated_trace_steps_length struct initialActive tallyOf
  have hidx_min :
      idx < min order.length struct.sequence.length := by
    change step.1 <
      min struct.finalOrder.order.length struct.sequence.length
    rw [← hlen]
    exact step.2
  have hidx_order : idx < order.length :=
    Nat.lt_of_lt_of_le hidx_min (Nat.min_le_left _ _)
  let candidate := order[idx]
  have hcandidate_eq :
      paper_generated_structure_step_candidate struct initialActive tallyOf
        step = candidate := by
    simp [paper_generated_structure_step_candidate, candidate, order, idx]
  have hdrop :
      order.drop idx = candidate :: order.drop (idx + 1) := by
    simpa [candidate, order, idx] using
      (List.drop_eq_getElem_cons (l := order) (i := idx) hidx_order)
  have hsplit :
      order = order.take idx ++ candidate :: order.drop (idx + 1) := by
    calc
      order = order.take idx ++ order.drop idx :=
        (List.take_append_drop idx order).symm
      _ = order.take idx ++ candidate :: order.drop (idx + 1) := by
        rw [hdrop]
  have hbefore :
      (((paper_generated_trace_of_structure struct initialActive tallyOf).steps.get
          step).beforeActive) =
        initialActive \ (order.take idx).toFinset := by
    have hbefore' :=
      OrderSequenceStructure.generatedTrace_get_beforeActive_eq_sdiff_take_toFinset
        struct initialActive tallyOf step
    simpa [paper_generated_trace_of_structure, rcvGeneratedTraceOfStructure,
      order, idx] using hbefore'
  have hprefix_inactive :
      ∀ c, c ∈ order.take idx →
        c ∉
          (((paper_generated_trace_of_structure struct initialActive tallyOf).steps.get
            step).beforeActive) := by
    intro c hc hactive
    rw [hbefore] at hactive
    exact (Finset.mem_sdiff.mp hactive).2 (by simpa using hc)
  have hcandidate_mem_order : candidate ∈ order := by
    simpa [candidate, order, idx] using List.getElem_mem (l := order) hidx_order
  have hidxOf : order.idxOf candidate = idx := by
    simpa [candidate, order, idx] using
      (List.Nodup.idxOf_getElem struct.finalOrder.nodup_order idx
        hidx_order)
  have hcandidate_not_prefix :
      candidate ∉ (order.take idx).toFinset := by
    intro hmem
    have hmem_list : candidate ∈ order.take idx := by
      simpa using hmem
    have hlt_idx : order.idxOf candidate < idx :=
      (List.mem_take_iff_idxOf_lt hcandidate_mem_order).mp hmem_list
    rw [hidxOf] at hlt_idx
    exact (Nat.lt_irrefl idx) hlt_idx
  have hcandidate_active :
      candidate ∈
        (((paper_generated_trace_of_structure struct initialActive tallyOf).steps.get
          step).beforeActive) := by
    rw [hbefore]
    exact Finset.mem_sdiff.mpr
      ⟨horder_subset (by simpa using hcandidate_mem_order),
        hcandidate_not_prefix⟩
  have hiff :=
    Ballot.nextActive_filter_eq_some_iff_of_split
      (order := order) (pref := order.take idx)
      (suffix := order.drop (idx + 1))
      (active :=
        (((paper_generated_trace_of_structure struct initialActive tallyOf).steps.get
          step).beforeActive))
      (candidate := candidate)
      (fun candidate => voter ∈ allocatedVoters candidate)
      hsplit hprefix_inactive hcandidate_active
  simpa
    [paper_algorithm3_generated_structure_exact_fill_from_candidate_allocations,
      order, hcandidate_eq] using hiff

