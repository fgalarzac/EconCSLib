/--
Paper Theorem 3.1 source-shaped slack-reduction certificate constructor from
the explicit STV-to-slack obligations: algorithm output, feasibility
preservation, reverse slack feasibility, cost preservation, and the paper's
linear operation bound.
-/
def paper_smart_allocation_slack_reduction_certificate_from_explicit_obligations
    {Addition Slack : Type*} [Fintype Slack]
    {algorithm : paper_smart_allocation_problem Addition → Addition}
    {operationCount : paper_smart_allocation_problem Addition → ℕ}
    (slackProblem : paper_smart_allocation_problem Addition →
      paper_smart_allocation_slack_filling_problem Slack)
    (slackOf :
      ∀ problem : paper_smart_allocation_problem Addition,
        Addition → Slack → ℕ)
    (additionOf :
      ∀ problem : paper_smart_allocation_problem Addition,
        (Slack → ℕ) → Addition)
    (algorithm_eq_additionOf :
      ∀ problem : paper_smart_allocation_problem Addition,
        algorithm problem =
          additionOf problem
            (SmartAllocationSlackFillingProblem.algorithm
              (slackProblem problem)))
    (feasible_of_slack_feasible :
      ∀ (problem : paper_smart_allocation_problem Addition)
        (allocation : Slack → ℕ),
        SmartAllocationSlackFillingProblem.feasible (slackProblem problem)
            allocation →
          problem.feasible (additionOf problem allocation))
    (slack_feasible_of_feasible :
      ∀ (problem : paper_smart_allocation_problem Addition)
        (addition : Addition),
        problem.feasible addition →
          SmartAllocationSlackFillingProblem.feasible (slackProblem problem)
            (slackOf problem addition))
    (cost_algorithm_eq_slack :
      ∀ problem : paper_smart_allocation_problem Addition,
        problem.cost (algorithm problem) =
          SmartAllocationSlackFillingProblem.cost (slackProblem problem)
            (SmartAllocationSlackFillingProblem.algorithm
              (slackProblem problem)))
    (cost_eq_slack_of_feasible :
      ∀ (problem : paper_smart_allocation_problem Addition)
        (addition : Addition),
        problem.feasible addition →
          problem.cost addition =
            SmartAllocationSlackFillingProblem.cost (slackProblem problem)
              (slackOf problem addition))
    (operationCount_le :
      ∀ problem : paper_smart_allocation_problem Addition,
        operationCount problem ≤
          SmartAllocationProblem.linearRuntimeBound problem) :
    paper_smart_allocation_slack_reduction_certificate
      (Slack := Slack) algorithm operationCount :=
  smartAllocationSlackReductionCertificate_of_explicit
    (Slack := Slack) (algorithm := algorithm) (operationCount := operationCount)
    slackProblem slackOf additionOf algorithm_eq_additionOf
    feasible_of_slack_feasible slack_feasible_of_feasible
    cost_algorithm_eq_slack cost_eq_slack_of_feasible operationCount_le

