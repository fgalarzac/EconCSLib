/--
Algorithm 7 Predict-Losses filter: candidates whose strict support from all
candidates, plus the budget, stays below the source first-choice threshold.

Source status: direct paper-facing definition/formula wrapper.
-/
def paper_predict_losses_candidates {Voter Candidate : Type*}
    [DecidableEq Candidate]
    (voters : Finset Voter) (ballots : Voter → RCVBallot Candidate)
    (candidates : Finset Candidate) (budget firstChoiceThreshold : ℕ) :
    Finset Candidate :=
  predictLossesCandidates voters ballots candidates budget firstChoiceThreshold

/--
Algorithm 7 Predict-Losses final-order convention: use the ordered list
returned by the Predict-Losses filter as the generated losing order.

Source status: direct paper-facing wrapper for the canonical Algorithm 7
loss-order convention.
-/
noncomputable def paper_predict_losses_final_order {Voter Candidate : Type*}
    [DecidableEq Candidate]
    (voters : Finset Voter) (ballots : Voter → RCVBallot Candidate)
    (candidates : Finset Candidate) (budget firstChoiceThreshold : ℕ) :
    FinalOrder Candidate where
  order :=
    (paper_predict_losses_candidates voters ballots candidates budget
      firstChoiceThreshold).toList
  nodup_order := by
    simpa [paper_predict_losses_candidates] using
      (Finset.nodup_toList
        (predictLossesCandidates voters ballots candidates budget
          firstChoiceThreshold))

/--
Algorithm 7 Predict-Losses transfer cap for a predicted losing source
candidate: the largest singleton strict-support transfer from that source to
any current candidate.

Source status: source-shaped transfer-value convention for the Algorithm 7
line that sorts `CL` by decreasing transferable votes.
-/
noncomputable def paper_predict_losses_strict_support_transfer_cap
    {Voter Candidate : Type*} [DecidableEq Candidate]
    (voters : Finset Voter) (ballots : Voter → RCVBallot Candidate)
    (candidates : Finset Candidate) (source : Candidate) : ℕ :=
  candidates.sup fun candidate =>
    paper_strict_support_count voters ballots {source} (∅ : Finset Candidate)
      candidate

/--
The strict-support transfer cap bounds every singleton transfer to a candidate
in the active candidate set.
-/
theorem paper_predict_losses_strict_support_transfer_cap_bounds_singleton
    {Voter Candidate : Type*} [DecidableEq Candidate]
    (voters : Finset Voter) (ballots : Voter → RCVBallot Candidate)
    {candidates : Finset Candidate} {source candidate : Candidate}
    (hcandidate : candidate ∈ candidates) :
    paper_strict_support_count voters ballots {source} (∅ : Finset Candidate)
        candidate ≤
      paper_predict_losses_strict_support_transfer_cap voters ballots
        candidates source := by
  simpa [paper_predict_losses_strict_support_transfer_cap] using
    (Finset.le_sup
      (s := candidates)
      (f := fun candidate =>
        paper_strict_support_count voters ballots {source}
          (∅ : Finset Candidate) candidate)
      hcandidate)

/--
Algorithm 7 Predict-Losses sorted losing order: enumerate the predicted losing
candidates by decreasing strict-support transfer cap.

Source status: direct wrapper for Algorithm 7's line that sorts `CL` by
decreasing transferable votes.
-/
noncomputable def paper_predict_losses_sorted_transfer_order
    {Voter Candidate : Type*} [DecidableEq Candidate]
    (voters : Finset Voter) (ballots : Voter → RCVBallot Candidate)
    (candidates : Finset Candidate) (budget firstChoiceThreshold : ℕ) :
    List Candidate :=
  List.insertionSort
    (fun earlier later =>
      paper_predict_losses_strict_support_transfer_cap voters ballots
          candidates later ≤
        paper_predict_losses_strict_support_transfer_cap voters ballots
          candidates earlier)
    (paper_predict_losses_candidates voters ballots candidates budget
      firstChoiceThreshold).toList

/--
Algorithm 7 Predict-Losses final-order convention with the source-level
decreasing-transfer sort applied to the predicted losing candidates.
-/
noncomputable def paper_predict_losses_sorted_transfer_final_order
    {Voter Candidate : Type*} [DecidableEq Candidate]
    (voters : Finset Voter) (ballots : Voter → RCVBallot Candidate)
    (candidates : Finset Candidate) (budget firstChoiceThreshold : ℕ) :
    FinalOrder Candidate where
  order :=
    paper_predict_losses_sorted_transfer_order voters ballots candidates budget
      firstChoiceThreshold
  nodup_order := by
    simpa [paper_predict_losses_sorted_transfer_order] using
      EconCSLib.FiniteSum.list_insertionSort_decreasing_value_nodup
        (fun source =>
          paper_predict_losses_strict_support_transfer_cap voters ballots
            candidates source)
        (Finset.nodup_toList
          (paper_predict_losses_candidates voters ballots candidates budget
            firstChoiceThreshold))

/--
The sorted Predict-Losses final order is pairwise decreasing in the
strict-support transfer cap.
-/
theorem paper_predict_losses_sorted_transfer_final_order_pairwise
    {Voter Candidate : Type*} [DecidableEq Candidate]
    (voters : Finset Voter) (ballots : Voter → RCVBallot Candidate)
    (candidates : Finset Candidate) (budget firstChoiceThreshold : ℕ) :
    (paper_predict_losses_sorted_transfer_final_order voters ballots candidates
      budget firstChoiceThreshold).order.Pairwise
      (fun earlier later =>
        paper_predict_losses_strict_support_transfer_cap voters ballots
            candidates later ≤
          paper_predict_losses_strict_support_transfer_cap voters ballots
            candidates earlier) := by
  simpa [paper_predict_losses_sorted_transfer_final_order,
    paper_predict_losses_sorted_transfer_order] using
      EconCSLib.FiniteSum.list_pairwise_decreasing_value_insertionSort
        (fun source =>
          paper_predict_losses_strict_support_transfer_cap voters ballots
            candidates source)
        ((paper_predict_losses_candidates voters ballots candidates budget
          firstChoiceThreshold).toList)

/--
Membership in the sorted Predict-Losses order is exactly membership in the
Predict-Losses candidate set.
-/
theorem mem_paper_predict_losses_sorted_transfer_final_order_iff
    {Voter Candidate : Type*} [DecidableEq Candidate]
    {voters : Finset Voter} {ballots : Voter → RCVBallot Candidate}
    {candidates : Finset Candidate} {budget firstChoiceThreshold : ℕ}
    {candidate : Candidate} :
    candidate ∈
        (paper_predict_losses_sorted_transfer_final_order voters ballots
          candidates budget firstChoiceThreshold).order ↔
      candidate ∈
        paper_predict_losses_candidates voters ballots candidates budget
          firstChoiceThreshold := by
  simpa [paper_predict_losses_sorted_transfer_final_order,
    paper_predict_losses_sorted_transfer_order] using
      (List.mem_insertionSort
        (r := fun earlier later =>
          paper_predict_losses_strict_support_transfer_cap voters ballots
              candidates later ≤
            paper_predict_losses_strict_support_transfer_cap voters ballots
              candidates earlier)
        (l := (paper_predict_losses_candidates voters ballots candidates budget
          firstChoiceThreshold).toList)
        (x := candidate))

/--
Profile-derived global first-choice cap used by the canonical Algorithm 7
routes.
