namespace DGJ24OptimalStrategiesRCV

open EconCSLib.SocialChoice.Voting
open scoped BigOperators

/--
Paper structure from Section 2.2: a pair of a final social choice order and a
per-round win/loss sequence.

Source status: direct paper-facing definition/formula wrapper.
-/
abbrev paper_rcv_structure (Candidate : Type*) := RCVStructure Candidate

/--
Paper Appendix B.2 round-level constraint object: active candidates, focused
candidate, win/loss label, source tally formula, and Droop quota for one round.

Source status: direct paper-facing definition/formula wrapper.
-/
abbrev paper_round_tally_constraint (Candidate : Type*) :=
  RCVRoundTallyConstraint Candidate

/--
Paper constraints from Proposition 2.1: for each structure, nonlinear
constraints in the voter-data variables define the ballot-space region where
the election outcome remains constant.

Source status: direct paper-facing definition/formula wrapper.
-/
abbrev paper_structure_constraints (Data Candidate : Type*) :=
  RCVStructureConstraints Data Candidate

/--
Paper Appendix B.2 canonical generated constraints from a deterministic
order-and-sequence structure classifier.

Source status: direct paper-facing definition/formula wrapper.
-/
def paper_structure_classifier_constraints {Data Candidate : Type*}
    (structureOf : Data → paper_rcv_structure Candidate) :
    paper_structure_constraints Data Candidate :=
  rcvStructureClassifierConstraints structureOf

/--
Paper Algorithms 1-2 structure read from a deterministic trace: the final
order is read by `finalOrderOf`, and the sequence is the trace's per-round
win/loss labels.

Source status: direct paper-facing definition/formula wrapper.
-/
def paper_structure_of_trace {Data Candidate : Type*}
    (traceOf : Data → RCVTrace Candidate)
    (finalOrderOf : Data → FinalOrder Candidate) :
    Data → paper_rcv_structure Candidate :=
  rcvStructureOfTrace traceOf finalOrderOf

/--
Paper Algorithms 1-2 concrete trace-generated constraints: a structure
matches a data point exactly when it has the final order and win/loss sequence
read from the deterministic trace update.

Source status: direct paper-facing definition/formula wrapper.
-/
def paper_trace_generated_structure_constraints {Data Candidate : Type*}
    (traceOf : Data → RCVTrace Candidate)
    (finalOrderOf : Data → FinalOrder Candidate) :
    paper_structure_constraints Data Candidate :=
  rcvTraceGeneratedStructureConstraints traceOf finalOrderOf

/--
Paper Algorithms 1-2 generated trace for a proposed structure: process the
structure's candidate order with its win/loss sequence, using the supplied
round-tally formula.

Source status: direct paper-facing definition/formula wrapper.
-/
def paper_generated_trace_of_structure {Candidate : Type*} [DecidableEq Candidate]
    (struct : paper_rcv_structure Candidate)
    (initialActive : Finset Candidate)
    (tallyOf : Finset Candidate → Candidate → ℕ) :
    RCVTrace Candidate :=
  rcvGeneratedTraceOfStructure struct initialActive tallyOf

/--
Paper Algorithms 1-2 terminal active set for the generated trace.

Source status: direct paper-facing definition/formula wrapper for the active
set obtained by processing the generated order/sequence trace.
-/
def paper_generated_trace_terminal_active {Candidate : Type*} [DecidableEq Candidate]
    (struct : paper_rcv_structure Candidate)
    (initialActive : Finset Candidate) : Finset Candidate :=
  rcvGeneratedTraceTerminalActive struct initialActive

/--
Paper Algorithms 1-2 generated trace sequence identity: the generated trace
recovers the structure's round labels up to the final-order length.

Source status: direct paper-facing definition/formula wrapper.
-/
theorem paper_generated_trace_round_sequence {Candidate : Type*}
    [DecidableEq Candidate]
    (struct : paper_rcv_structure Candidate)
    (initialActive : Finset Candidate)
    (tallyOf : Finset Candidate → Candidate → ℕ) :
    (paper_generated_trace_of_structure struct initialActive tallyOf).roundOutcomeSequence =
      struct.sequence.take struct.finalOrder.order.length := by
  exact rcvGeneratedTrace_roundOutcomeSequence struct initialActive tallyOf

/--
Paper Algorithms 1-2 generated trace sequence identity for valid structures:
when the structure has one label per ordered candidate, the generated trace
recovers exactly the structure's round labels.

Source status: direct paper-facing theorem wrapper.
-/
theorem paper_generated_trace_round_sequence_of_valid_length
    {Candidate : Type*} [DecidableEq Candidate]
    {struct : paper_rcv_structure Candidate}
    {initialActive : Finset Candidate}
    {tallyOf : Finset Candidate → Candidate → ℕ}
    (hvalid : struct.validLength) :
    (paper_generated_trace_of_structure struct initialActive tallyOf).roundOutcomeSequence =
      struct.sequence := by
  exact rcvGeneratedTrace_roundOutcomeSequence_of_validLength
    (struct := struct) (initialActive := initialActive) (tallyOf := tallyOf)
    hvalid

/--
Paper Algorithms 1-2 generated trace length identity: the source trace has one
step for each paired order/sequence entry.

Source status: direct paper-facing theorem wrapper.
-/
theorem paper_generated_trace_steps_length {Candidate : Type*}
    [DecidableEq Candidate]
    (struct : paper_rcv_structure Candidate)
    (initialActive : Finset Candidate)
    (tallyOf : Finset Candidate → Candidate → ℕ) :
    (paper_generated_trace_of_structure struct initialActive tallyOf).steps.length =
      min struct.finalOrder.order.length struct.sequence.length := by
  exact rcvGeneratedTrace_steps_length struct initialActive tallyOf

/--
Paper Algorithms 1-2 generated trace replay: processing the generated trace
replays the active-set update from the initial active set to the generated
terminal active set.

Source status: direct paper-facing theorem wrapper for the Algorithm 2 active
set recursion.
-/
theorem paper_generated_trace_replays_from_initial_to_terminal
    {Candidate : Type*} [DecidableEq Candidate]
    (struct : paper_rcv_structure Candidate)
    (initialActive : Finset Candidate)
    (tallyOf : Finset Candidate → Candidate → ℕ) :
    (paper_generated_trace_of_structure struct initialActive tallyOf).replaysFrom
      initialActive (paper_generated_trace_terminal_active struct initialActive) := by
  exact rcvGeneratedTrace_replaysFrom struct initialActive tallyOf

/--
Paper Algorithms 1-2 generated trace step-kind identity: the generated trace
renders the structure's win/loss labels as elect/eliminate step kinds.

Source status: direct paper-facing theorem wrapper.
-/
theorem paper_generated_trace_step_kinds {Candidate : Type*}
    [DecidableEq Candidate]
    (struct : paper_rcv_structure Candidate)
    (initialActive : Finset Candidate)
    (tallyOf : Finset Candidate → Candidate → ℕ) :
    (paper_generated_trace_of_structure struct initialActive tallyOf).steps.map
        STVStep.kind =
      (struct.sequence.take struct.finalOrder.order.length).map
        RoundOutcome.toStepKind := by
  exact rcvGeneratedTrace_stepKinds struct initialActive tallyOf

/--
Paper Algorithms 1-2 generated trace indexed tally identity: every generated
step uses the supplied tally formula for its own active set.

Source status: direct paper-facing theorem wrapper.
-/
theorem paper_generated_trace_tally_eq {Candidate : Type*}
    [DecidableEq Candidate]
    (struct : paper_rcv_structure Candidate)
    (initialActive : Finset Candidate)
    (tallyOf : Finset Candidate → Candidate → ℕ)
    (i :
      Fin
        (paper_generated_trace_of_structure struct initialActive
          tallyOf).steps.length) :
    (((paper_generated_trace_of_structure struct initialActive tallyOf).steps.get
        i).tally) =
      tallyOf
        (((paper_generated_trace_of_structure struct initialActive
          tallyOf).steps.get i).beforeActive) := by
  exact OrderSequenceStructure.generatedTrace_tally_eq struct initialActive
    tallyOf i

/--
Paper Algorithms 1-2 generated trace indexed kind classification: each
generated step is either an election or an elimination step.

Source status: direct paper-facing theorem wrapper.
-/
theorem paper_generated_trace_kind_elect_or_eliminate
    {Candidate : Type*} [DecidableEq Candidate]
    (struct : paper_rcv_structure Candidate)
    (initialActive : Finset Candidate)
    (tallyOf : Finset Candidate → Candidate → ℕ)
    (i :
      Fin
        (paper_generated_trace_of_structure struct initialActive
          tallyOf).steps.length) :
    (((paper_generated_trace_of_structure struct initialActive tallyOf).steps.get
        i).kind = StepKind.elect) ∨
      (((paper_generated_trace_of_structure struct initialActive tallyOf).steps.get
        i).kind = StepKind.eliminate) := by
  exact OrderSequenceStructure.generatedTrace_kind_elect_or_eliminate struct
    initialActive tallyOf i

/--
Paper Algorithms 1-2 generated trace active-set update: every generated step
removes the focused candidate from the active set.

Source status: direct paper-facing theorem wrapper for the Algorithm 2 active
candidate update.
-/
theorem paper_generated_trace_removes_focused_candidate
    {Candidate : Type*} [DecidableEq Candidate]
    (struct : paper_rcv_structure Candidate)
    (initialActive : Finset Candidate)
    (tallyOf : Finset Candidate → Candidate → ℕ) :
    ∀ step,
      step ∈ (paper_generated_trace_of_structure struct initialActive
        tallyOf).steps →
        step.removesFocusedCandidate := by
  exact rcvGeneratedTrace_removesFocusedCandidate struct initialActive tallyOf

/--
Paper Algorithms 1-2 generated trace focused loss-prefix replay: if the
structure's candidate order and round labels start with a listed loss prefix,
then the generated trace eliminates exactly that focused prefix first.

Source status: direct paper-facing theorem wrapper.
-/
theorem paper_generated_trace_initial_elimination_focus_prefix_of_loss_prefix
    {Candidate : Type*} [DecidableEq Candidate]
    {struct : paper_rcv_structure Candidate}
    {initialActive : Finset Candidate}
    {lossPrefix restOrder : List Candidate}
    {restSequence : List RoundOutcome}
    {tallyOf : Finset Candidate → Candidate → ℕ}
    (horder : struct.finalOrder.order = lossPrefix ++ restOrder)
    (hsequence :
      struct.sequence =
        List.replicate lossPrefix.length RoundOutcome.lose ++ restSequence) :
    (paper_generated_trace_of_structure struct initialActive tallyOf).HasInitialEliminationFocusPrefix
      lossPrefix := by
  exact
    OrderSequenceStructure.generatedTrace_hasInitialEliminationFocusPrefix_of_lossPrefix
      (struct := struct) (initialActive := initialActive) (tallyOf := tallyOf)
      horder hsequence

/--
Paper Algorithms 1-2 generated trace initial-loss replay: if the structure's
round labels have a losing prefix of length `length`, then the generated trace
has an initial elimination prefix of that length.

Source status: direct paper-facing theorem wrapper.
-/
theorem paper_generated_trace_initial_elimination_prefix_of_initial_loss_prefix
    {Candidate : Type*} [DecidableEq Candidate]
    {struct : paper_rcv_structure Candidate}
    {initialActive : Finset Candidate}
    {tallyOf : Finset Candidate → Candidate → ℕ}
    {length : ℕ}
    (horder : length ≤ struct.finalOrder.order.length)
    (hprefix : rcvSequenceHasInitialLossPrefix struct.sequence length) :
    (paper_generated_trace_of_structure struct initialActive tallyOf).HasInitialEliminationPrefix
      length := by
  exact
    OrderSequenceStructure.generatedTrace_hasInitialEliminationPrefix_of_initialLossPrefix
      (struct := struct) (initialActive := initialActive) (tallyOf := tallyOf)
      horder hprefix

/--
Paper Algorithms 1-2 generated trace initial-loss replay, indexed form: every
generated step in the certified losing prefix is an elimination step.

Source status: direct paper-facing theorem wrapper.
-/
theorem paper_generated_trace_get_kind_eq_eliminate_of_initial_loss_prefix
    {Candidate : Type*} [DecidableEq Candidate]
    {struct : paper_rcv_structure Candidate}
    {initialActive : Finset Candidate}
    {tallyOf : Finset Candidate → Candidate → ℕ}
    {length : ℕ}
    (horder : length ≤ struct.finalOrder.order.length)
    (hprefix : rcvSequenceHasInitialLossPrefix struct.sequence length)
    (i : Fin length) :
    let trace := paper_generated_trace_of_structure struct initialActive tallyOf
    (trace.steps.get ⟨i.1, Nat.lt_of_lt_of_le i.2
      (paper_generated_trace_initial_elimination_prefix_of_initial_loss_prefix
        (struct := struct) (initialActive := initialActive) (tallyOf := tallyOf)
        horder hprefix).1⟩).kind = StepKind.eliminate := by
  let trace := paper_generated_trace_of_structure struct initialActive tallyOf
  have hinit :
      trace.HasInitialEliminationPrefix length :=
    paper_generated_trace_initial_elimination_prefix_of_initial_loss_prefix
      (struct := struct) (initialActive := initialActive) (tallyOf := tallyOf)
      horder hprefix
  exact STVTrace.get_kind_eq_of_initialEliminationPrefix hinit i

/--
Paper Algorithms 1-2 generated round constraints for a proposed structure.
The source-specific nonlinear tally formula is supplied as `tallyOf`; each
generated row records the active set, focused candidate, win/loss label, and
quota inequality to be checked at that round.

Source status: direct paper-facing definition/formula wrapper.
