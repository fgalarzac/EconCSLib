    paper_strict_support_count voters ballots {source}
        (∅ : Finset Candidate) candidate ≤
        Ballot.firstChoiceCount voters ballots source := by
      simpa [paper_strict_support_count, strictSupportCount] using
        Ballot.strictSupportCount_singleton_le_firstChoiceCount
          (voters := voters) (ballots := ballots) (source := source)
